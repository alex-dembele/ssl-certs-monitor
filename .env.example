# Docker Compose
POSTGRES_PASSWORD=change-this-password
BACKEND_API_TOKEN=
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# URLs for a manual installation (Docker Compose sets these internally)
API_URL=http://localhost:8000
BACKEND_API_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://monitor:change-this-password@localhost:5432/ssl_monitor
LEGACY_DOMAINS_FILE=domains.json

# Email notifications (optional; required only when email alerts are enabled)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_RECIPIENTS=recipient@example.com

# Other notification channels are optional
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_SECRET=
