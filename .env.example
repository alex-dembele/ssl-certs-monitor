# --- Sécurité de l'API (obligatoire en production) ---
# Jeton partagé entre le frontend (proxy serveur) et le backend.
BACKEND_API_TOKEN=change-me
APP_ENV=development
# Origines autorisées à appeler l'API directement (séparées par des virgules).
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
# URL du backend vue par le serveur Next.js, lue à l'exécution (pas au build).
BACKEND_API_URL=http://localhost:8000

# --- Base de données ---
POSTGRES_PASSWORD=monitor
# Hors Docker : DATABASE_URL=postgresql+psycopg://monitor:monitor@localhost:5432/ssl_monitor

# --- Vérifications ---
# Utilisé tant que l'intervalle n'est pas défini dans Paramètres > Organisation.
CHECK_INTERVAL_MINUTES=60

# --- Email (optionnel) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_RECIPIENTS=recipient@example.com
